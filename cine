#!/bin/bash
# Arranca One TV. Uso: ./cine  |  ./cine configurar  |  ./cine autoarranque  |  ./cine estado  |  ./cine catalogo
# Antes revisa que estén los programas que hacen falta y, si falta alguno, dice el comando exacto para instalarlo.
DIR="$(cd "$(dirname "$0")" && pwd)"

# Lo que el instalador (instalar.sh) bajó para One TV en una Mac que no lo tenía: ffmpeg en programas/bin y Python
# en programas/python. Se usa primero; si no está, los de la computadora.
[ -d "$DIR/programas/bin" ] && export PATH="$DIR/programas/bin:$PATH"
PY=python3
[ -x "$DIR/programas/python/bin/python3" ] && PY="$DIR/programas/python/bin/python3"

if [ "$(uname -s)" = "Linux" ]; then
  falta=()
  if ! command -v python3 >/dev/null 2>&1; then
    falta+=(python3 python3-venv)
  elif ! python3 -c 'import ensurepip, venv' >/dev/null 2>&1; then
    falta+=(python3-venv)   # sin esto no se puede instalar yt-dlp (YouTube) en su entorno aparte
  fi
  if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
    falta+=(ffmpeg)
  fi
  if [ ${#falta[@]} -gt 0 ]; then
    echo "✗ Faltan programas que One TV necesita: ${falta[*]}"
    if command -v apt-get >/dev/null 2>&1; then
      echo "  Instálalos con este comando (te pide tu contraseña) y vuelve a correr ./cine:"
      echo
      echo "    sudo apt update && sudo apt install -y ${falta[*]}"
    else
      echo "  Instálalos con el instalador de programas de tu sistema y vuelve a correr ./cine."
    fi
    exit 1
  fi
else
  # macOS: /usr/bin/python3 no es Python de verdad hasta que se instalan las herramientas de Xcode (usarlo abriría su
  # instalador). El instalador de One TV pone Python y ffmpeg solo para One TV, sin tocar nada más de la Mac.
  instalador="curl -fsSL https://raw.githubusercontent.com/julai1433/one-tv/main/instalar.sh | bash"
  if [ "$PY" = python3 ]; then
    p="$(command -v python3)"
    d="$(xcode-select -p 2>/dev/null)"
    if [ -z "$p" ] || { [ "$p" = /usr/bin/python3 ] && [ ! -x "$d/usr/bin/python3" ]; }; then
      echo "✗ Falta Python, que One TV necesita. El instalador de One TV lo pone solo; pega esto en la Terminal:"
      echo
      echo "    $instalador"
      exit 1
    fi
  fi
  if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
    echo "✗ Falta ffmpeg, que One TV necesita. El instalador de One TV lo pone solo; pega esto en la Terminal:"
    echo
    echo "    $instalador"
    echo
    echo "  (O, si usas Homebrew:  brew install ffmpeg)"
    exit 1
  fi
fi

if ! "$PY" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
  echo "✗ One TV necesita Python 3.9 o más nuevo (tienes $("$PY" --version 2>&1))."; exit 1
fi
exec "$PY" "$DIR/mac/cine.py" "$@"
