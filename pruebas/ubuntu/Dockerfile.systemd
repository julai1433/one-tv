# Ubuntu 24.04 que arranca con systemd (como una computadora de verdad), con SSH para entrar como un usuario normal
# («ana») y lo mismo que pide ./cine. Lo usa pruebas/ubuntu_systemd.sh para probar ./cine autoarranque.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus dbus-user-session libpam-systemd polkitd \
      openssh-server openssh-client python3 python3-venv ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash ana \
 && ssh-keygen -q -t ed25519 -N "" -f /root/.ssh/id_ed25519 \
 && mkdir -p /home/ana/.ssh && cp /root/.ssh/id_ed25519.pub /home/ana/.ssh/authorized_keys \
 && chown -R ana:ana /home/ana/.ssh && chmod 700 /home/ana/.ssh && chmod 600 /home/ana/.ssh/authorized_keys \
 && systemctl enable ssh
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
